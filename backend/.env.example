# Database (defaults to SQLite in backend/highlights.db)
# DATABASE_URL=sqlite+aiosqlite:///./highlights.db

# Anthropic API key for Claude vision OCR (highly recommended)
# Without this, falls back to Tesseract which is much less accurate
ANTHROPIC_API_KEY=

# Ghost publishing (optional)
# Get your Admin API key from Ghost Admin > Settings > Integrations
GHOST_API_URL=
GHOST_ADMIN_API_KEY=

# Roam Research publishing (optional)
# Get your API token from Roam Research > Settings > Graph > API tokens
ROAM_GRAPH_NAME=
ROAM_API_TOKEN=
